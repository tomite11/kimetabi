{
  "name": "kimetabi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:api && tsc -b && vite build",
    "generate:api": "openapi-typescript ../openapi/openapi.json -o src/api/generated/schema.d.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run src --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "npm run generate:api && tsc -b --pretty false"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
